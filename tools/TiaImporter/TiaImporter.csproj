<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Command-line tool that uses TIA Portal Openness (V20) to:
      export      open a .zap20 archive headless and export the whole PLC program to files
      setup-demo  load the demo PLC program into an existing TIA project
    Needs: Windows, TIA Portal V20 with Openness, user in the "Siemens TIA Openness" group.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Change this if TIA Portal is installed somewhere else -->
    <TiaInstallDir Condition="'$(TiaInstallDir)' == ''">C:\Program Files\Siemens\Automation\Portal V20</TiaInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Openness assemblies are loaded from the TIA install at runtime (see OpennessResolver.cs), never copied -->
    <Reference Include="$(TiaInstallDir)\PublicAPI\V20\**\Siemens.Engineering.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
