<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- PLC-Ki web server: reads the PLC (read-only) and serves the live status page. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlcKi.Server</RootNamespace>
    <AssemblyName>PlcKi.Server</AssemblyName>
    <!-- "dotnet run" keeps the folder you run it from, so relative paths on the command line mean what you typed -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- S7CommPlus driver (LGPL-3.0-or-later), fork of thomas-v2/S7CommPlusDriver by DotNetProjects -->
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="DotNetProjects.S7CommPlusDriver" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlcKi.Core\PlcKi.Core.csproj" />
    <ProjectReference Include="..\PlcKi.Plant\PlcKi.Plant.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Block generator: default standard and reference blocks that are proven to import and compile in TIA V20 -->
    <EmbeddedResource Include="..\..\knowledge\block-standard.md" LogicalName="PlcKi.Server.Generate.block-standard.md" />
    <EmbeddedResource Include="..\..\plc-demo\scl\13_FB_Valve.scl" LogicalName="PlcKi.Server.Generate.ref.FB_Valve.scl" />
    <EmbeddedResource Include="..\..\plc-demo\scl\17_DB_BatchSequence.db" LogicalName="PlcKi.Server.Generate.ref.DB_BatchSequence.db" />
    <EmbeddedResource Include="..\..\plc-demo\lad\13_FB_Valve.xml" LogicalName="PlcKi.Server.Generate.ref.FB_Valve.xml" />
    <EmbeddedResource Include="..\..\plc-demo\graph\16_FB_BatchSequence.xml" LogicalName="PlcKi.Server.Generate.ref.FB_BatchSequence.xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy the web page next to the exe so "dotnet run" and the built exe serve the same files -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\*.json" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\*.zip" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\snapshots\*.json" Link="models\snapshots\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
