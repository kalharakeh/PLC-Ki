{
  "PlcKi": {
    // Machine model: what the program means (tags, steps, equipment, alarms)
    "Model": "models/demo-mixing-station.json",
    // "s7" = live PLC (read-only), "snapshot" = values from a JSON file, for testing without a PLC
    "Source": "s7",
    "SnapshotFile": "models/snapshots/step10-xv101-not-open.json",
    "Plc": {
      "Address": "192.168.10.10",
      // Only if the CPU has an access password. Better: set the PLCKI_PLC_PASSWORD environment variable.
      "Password": "",
      // Auto = TLS first, then the older challenge login (used by PLCSIM and CPUs without secure communication)
      "Security": "Auto",
      "PollMs": 1000,
      "TimeoutMs": 5000
    },
    // Minutes of tag values kept in memory, so the assistant can answer "what happened before the alarm?"
    "HistoryMinutes": 15,
    // "Ask a question" box. Uses Claude; the key is read from the ANTHROPIC_API_KEY environment variable.
    "Ask": {
      "Enabled": true,
      "Model": "claude-opus-5-5",
      // low / medium / high / max: higher thinks longer and costs more
      "Effort": "medium"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
