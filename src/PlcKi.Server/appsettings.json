{
  "PlcKi": {
    // Machine model: what the program means (tags, steps, equipment, alarms)
    "Model": "models/demo-mixing-station.json",
    // The program export the model was built from (TiaImporter export): shown on the Program page
    "Export": "models/demo-export.zip",
    // "s7" = live PLC (read-only), "snapshot" = values from a JSON file, for testing without a PLC
    "Source": "s7",
    "SnapshotFile": "models/snapshots/step10-xv101-not-open.json",
    "Plc": {
      // Empty on a fresh install: set it on the Connections page
      "Address": "",
      // Only if the CPU has an access password. Better: set the PLCKI_PLC_PASSWORD environment variable.
      "Password": "",
      // Auto = TLS first, then the older challenge login (used by PLCSIM and CPUs without secure communication)
      "Security": "Auto",
      "PollMs": 1000,
      // Fast capture: the PLC sends every change of the model tags, sampled this often (ms), like an HMI does.
      // Gives the seconds before each alarm (Alarm recordings) and catches pulses the 1 s reads miss. 0 = off.
      "FastMs": 100,
      "TimeoutMs": 5000,
      // "direct" = this PC reads the PLC; "link" = PLC-Ki Link on a laptop reads it and sends the values here
      "Via": "direct"
    },
    // Where TIA Portal is, for the import page and the block generator (both use TiaImporter serve):
    // "local" = this PC (PLC-Ki starts TiaImporter itself), "remote" = another PC or VM running serve, "link" = a laptop with PLC-Ki Link
    "Tia": {
      "Mode": "remote",
      "Url": "",
      "ImporterPath": "",
      "PlcsimIp": "",
      "AllowReal": "",
      "Project": "",
      "Port": 5090
    },
    // Minutes of tag values kept in memory, so the assistant can answer "what happened before the alarm?"
    "HistoryMinutes": 15,
    // "Ask a question" box. Uses Claude; the key is entered under Setup, Settings (or the ANTHROPIC_API_KEY environment variable).
    "Ask": {
      "Enabled": true,
      "Model": "claude-opus-5-5",
      // low / medium / high / max: higher thinks longer and costs more
      "Effort": "medium"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
