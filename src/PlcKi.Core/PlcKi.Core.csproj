<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine model, expression evaluator and status engine. No PLC driver here, so it builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlcKi.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Siemens system and diagnostic messages explained (general knowledge, used by the Ask tools) -->
    <EmbeddedResource Include="..\..\knowledge\siemens-diagnostics.json" LogicalName="PlcKi.Core.Knowledge.siemens-diagnostics.json" />
    <!-- Fault codes of other devices: FANUC robot alarms, IO-Link events (general knowledge) -->
    <EmbeddedResource Include="..\..\knowledge\device-faults.json" LogicalName="PlcKi.Core.Knowledge.device-faults.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reads the text of PDF manuals and drawings for the document library (Apache-2.0) -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
