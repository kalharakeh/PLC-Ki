<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PlcKi.Core\PlcKi.Core.csproj" />
    <!-- AskTests run the assistant against a fake API; ReadOnlyTests inspect the compiled server -->
    <ProjectReference Include="..\..\src\PlcKi.Server\PlcKi.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\models\*.json" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\snapshots\*.json" Link="models\snapshots\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Export of the demo project by tools/TiaImporter from TIA V20 (2 Nov 2026) -->
    <None Include="data\*.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A small Beckhoff TwinCAT 3 project written by hand in the TwinCAT 3.1 file format -->
    <None Include="data\twincat-demo\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
