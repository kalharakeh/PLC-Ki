<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build file for the vendored S7CommPlusDriver (LGPL-3.0, see LICENSE and README.md).
    Built as its own DLL so the driver stays a separate, replaceable library.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>S7CommPlusDriver</AssemblyName>
    <RootNamespace>S7CommPlusDriver</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Upstream code: keep the build quiet, we do not change its style -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0162;CS0219;CS0414;CS0649;CS0618;CS8981;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0045</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The driver picks the 64-bit OpenSSL DLL names with this symbol -->
    <DefineConstants>$(DefineConstants);_WIN64</DefineConstants>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <None Include="S7CommPlusDriver\OpenSSL-dll-x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
